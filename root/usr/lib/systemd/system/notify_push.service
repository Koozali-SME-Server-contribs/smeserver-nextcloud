[Unit]
Description = Push daemon for Nextcloud clients
#ConditionPathExists=/usr/share/nextcloud/apps/notify_push/bin/x86_64/notify_push
[Service]
Environment=PORT=7867
#Environment=NEXTCLOUD_URL=https://CHANGEME
ExecStartPre=/usr/bin/test -f /usr/share/nextcloud/apps/notify_push/bin/x86_64/notify_push
ExecStart=/usr/share/nextcloud/apps/notify_push/bin/x86_64/notify_push /usr/share/nextcloud/config/config.php
Type=notify
User=apache
Restart=on-failure
RestartSec=30

[Install]
WantedBy=sme-server.target
